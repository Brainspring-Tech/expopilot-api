# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings -> API -> JWT Secret. Used to mint short-lived session
# tokens for API-key requests' shadow users (see src/services/apiKeys.js)
# — NOT the same value as SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_JWT_SECRET=your-project-jwt-secret

# API auth — generate a long random string, used by frontend to authenticate requests
API_SECRET_KEY=replace-with-64-char-random-string

# HubSpot
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token
HUBSPOT_PORTAL_ID=your-portal-id

# Microsoft Graph (for staff email alerts)
MS_TENANT_ID=your-tenant-id
MS_CLIENT_ID=your-client-id
MS_CLIENT_SECRET=your-client-secret
MS_SENDER_EMAIL=orders@brainspring.com

# MailerLite
MAILERLITE_API_KEY=your-mailerlite-api-key

# App
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://brainsync.netlify.app
